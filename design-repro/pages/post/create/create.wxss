.create { padding-top: 0; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

.nav { display: flex; align-items: flex-end; padding: 0 24rpx 8rpx; }
.nav__back { font-size: 48rpx; color: var(--text-1); width: 60rpx; }
.nav__title { font-size: var(--fs-nav); margin: 0 auto; transform: translateX(-30rpx); }

.label { font-size: var(--fs-caption); color: var(--text-2); margin: 28rpx 0 14rpx; }
.label:first-child { margin-top: 0; }
.req { color: var(--danger); }

.chips { display: flex; gap: 16rpx; }

.field--block { margin-bottom: 16rpx; }
.ta {
  width: 100%; height: 260rpx; background: var(--bg-field); border-radius: var(--r-field);
  padding: 24rpx 28rpx; font-size: var(--fs-body); color: var(--text-1); line-height: 1.7;
}
.counter { text-align: right; font-size: var(--fs-micro); color: var(--text-3); margin-top: 8rpx; }
.counter--warn { color: var(--warn-fg); }

.media { display: flex; flex-wrap: wrap; gap: 16rpx; }
.media__item { width: 200rpx; height: 200rpx; border-radius: var(--r-img); position: relative; }
.media__del {
  position: absolute; top: 6rpx; right: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,.45); color: #fff; font-size: 28rpx; text-align: center; line-height: 40rpx;
}
.media__add {
  width: 200rpx; height: 200rpx; border-radius: var(--r-img); border: 2rpx dashed var(--border-strong);
  display: flex; align-items: center; justify-content: center; font-size: 64rpx; color: var(--text-disabled);
}

/* 底部发布栏 */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-radius: var(--r-img) var(--r-img) 0 0; box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.04);
}
.bar__btn { width: 100%; }
