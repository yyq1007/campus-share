<!--S7 审核台：居中标题 + 三 Tab（待审/举报/已处理）+ 卡片（板块 chip + AI 判定 chip + 时间）+ 驳回/通过 -->
<view class="page">
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-inner" style="height:{{navH}}px">
      <view class="nav-btn" bind:tap="onBack">
        <image class="nav-btn-icon" src="/assets/icons/arrow-left.png" mode="aspectFit" />
      </view>
      <view class="nav-title">审核台</view>
      <view class="nav-ph" />
    </view>
  </view>

  <!-- 三 Tab -->
  <view class="tabs">
    <view class="tab {{tab === 'pending' ? 'is-on' : ''}}" data-key="pending" bind:tap="onTabTap">
      <text>待审 {{counts.pending}}</text>
      <view wx:if="{{tab === 'pending'}}" class="tab-line" />
    </view>
    <view class="tab {{tab === 'report' ? 'is-on' : ''}}" data-key="report" bind:tap="onTabTap">
      <text>举报 {{counts.report}}</text>
      <view wx:if="{{tab === 'report'}}" class="tab-line" />
    </view>
    <view class="tab {{tab === 'done' ? 'is-on' : ''}}" data-key="done" bind:tap="onTabTap">
      <text>已处理</text>
      <view wx:if="{{tab === 'done'}}" class="tab-line" />
    </view>
  </view>

  <!-- 无权限 -->
  <view wx:if="{{state === 'denied'}}" class="state-wrap">
    <image class="state-icon" src="/assets/deco/cat.png" mode="aspectFit" />
    <view class="state-text">此页面仅审核员可见</view>
  </view>
  <page-state wx:elif="{{state === 'loading' || state === 'error' || state === 'empty'}}" state="{{state}}" bind:retry="onRetry" />

  <scroll-view wx:else scroll-y class="list" bindscrolltolower="onMore">
    <view class="item" wx:for="{{list}}" wx:key="queueId">
      <view class="item-head">
        <view class="chips">
          <view class="board-chip board-{{item.board}}">
            <image class="board-sticker" src="/assets/icons/{{item.boardSticker}}.png" mode="aspectFit" />
            <text>{{item.boardLabel}}</text>
          </view>
          <view wx:if="{{item.aiTag}}" class="ai-chip">
            <text>{{item.aiTag}}</text>
          </view>
        </view>
        <text class="item-time">{{item.timeText}}</text>
      </view>

      <view class="item-content">{{item.content}}</view>
      <image
        wx:if="{{item.cover}}" class="item-cover" src="{{item.cover}}"
        mode="aspectFill" data-url="{{item.cover}}" bind:tap="onPreview"
      />
      <view wx:if="{{item.reportReason}}" class="item-meta">举报理由：{{item.reportReason}}</view>

      <!-- 已处理 Tab 只展示结果，无操作按钮 -->
      <view wx:if="{{tab !== 'done'}}" class="item-actions">
        <view wx:if="{{tab === 'report'}}" class="act-btn reject" data-id="{{item.queueId}}" bind:tap="onReject">举报不成立</view>
        <view wx:else class="act-btn reject" data-id="{{item.queueId}}" bind:tap="onReject">驳回</view>
        <view wx:if="{{tab === 'report'}}" class="act-btn hide" data-id="{{item.queueId}}" bind:tap="onHide">下线</view>
        <view wx:else class="act-btn approve" data-id="{{item.queueId}}" bind:tap="onApprove">通过</view>
      </view>
      <view wx:else class="item-done">{{item.doneText}}</view>
    </view>
    <view class="pad" />
  </scroll-view>
</view>
