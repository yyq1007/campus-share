.tab-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  /* 高度只含图标行；安全区只由 padding-bottom 承担一次（此前 height+padding 双算，
     多出一截白底延伸到屏幕底外） */
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  /* custom-tab-bar 独立于页面渲染，page 上的 CSS 变量在部分环境拿不到：
     全部 var() 带同值兜底（与 theme.wxss 同步），保证背景永远不透明 */
  background: var(--bg-elevated, #FFFFFF);
  box-shadow: 0 -8rpx 32rpx var(--brand-a06, rgba(108, 92, 231, 0.06));
  z-index: 100;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tab-text {
  font-size: 22rpx;
  color: var(--text-2, #6B6780);
}
.tab-item.on .tab-text { color: var(--brand-800, #5A47C9); font-weight: 600; }
/* 未读红点：图标右上角的实心圆，承载「站内消息」导航级提示 */
.tab-ico-wrap { position: relative; line-height: 0; }
.tab-badge {
  position: absolute;
  top: -2rpx;
  right: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--badge-red, #FF4D4F);
  border: 2rpx solid var(--bg-elevated, #FFFFFF);
  box-sizing: border-box;
}
/* 发布项与普通项一致（加榜单之前的形态：无凸起圆钮、无渐变胶囊）。
   4 项均分后左右完全对称，也就不用再为「胶囊偏右」做任何补偿。 */
.tab-publish-text { color: var(--text-2, #6B6780); font-weight: 500; }

/* 未同意隐私协议：整条 bar 锁定 */
.tab-bar.is-locked .tab-item { opacity: .35; }
.tab-bar.is-locked .tab-text { color: var(--text-3, #9A96AC); }
.tab-lock {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 不透明底，盖住图标与文字，避免看起来还能点 */
  background: var(--bg-elevated, #FFFFFF);
  z-index: 2;
}
.tab-lock-text {
  font-size: 24rpx;
  color: var(--text-2, #6B6780);
}
