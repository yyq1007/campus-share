<!-- 周报卡（board='digest'）：板块流与首页流都不再出现周报（周报只从首页入口进），
     这里保留为兜底——搜索命中周报帖时仍要能渲染。点进详情页看全文 + 可跳转的原帖列表 -->
<view wx:if="{{post.isDigest}}" class="pc pc-digest" bindtap="onTap">
  <view class="pc-digest-head">
    <view class="pc-digest-badge">周报</view>
    <view class="pc-digest-count">{{post.itemCount}} 条精选</view>
  </view>
  <view class="pc-digest-summary">{{post.excerpt}}</view>
  <view class="pc-digest-foot">点击查看完整周报与全部精选</view>
</view>

<!-- 普通帖子卡（信息流样式：头像+昵称/时间 → 正文 → 图片 → 话题 → 赞/评论/收藏） -->
<view wx:else class="pc card" bindtap="onTap">
  <view class="pc-head">
    <!-- 匿名糖果色头像（按帖子 id 取色，不泄露作者） -->
    <view class="pc-avatar av-{{avatarIdx}}">匿</view>
    <view class="pc-main">
      <view class="pc-name-row">
        <text class="pc-name">匿名同学</text>
        <!-- 状态角标（仅「我的分享」）：占样例里「热门」的位置 -->
        <view wx:if="{{statusText}}" class="pc-status st-{{post.status}}">{{statusText}}</view>
      </view>
      <view class="pc-sub">
        <text>{{timeText}}</text>
        <text wx:if="{{post.expired}}" class="pc-expired"> · 可能已过期</text>
      </view>

      <view wx:if="{{post.title}}" class="pc-title">{{post.title}}</view>
      <view class="pc-excerpt">{{post.excerpt}}</view>

      <!-- 图片/视频：排在正文下方（不再占据卡片顶部通栏）。
           高度用内联 padding-top 百分比（相对卡片宽度）占位，图片 onload 后按真实比例更新，
           避免竖图被固定 400rpx 的框裁成一条横条。 -->
      <view wx:if="{{post.cover}}" class="pc-media" style="padding-top:{{coverRatio}}%;">
        <image class="pc-cover" src="{{post.cover}}" mode="aspectFill" lazy-load="{{true}}" bind:load="onCoverLoad" />
        <view wx:if="{{post.mediaType === 'video'}}" class="pc-play">
          <icon name="play-white" size="36"/>
        </view>
      </view>

      <!-- 话题（板块）：描边小胶囊 -->
      <view wx:if="{{showBoard && boardLabel}}" class="pc-topic">
        <icon name="{{boardSticker}}" size="26" />
        <text class="pc-topic-text">{{boardLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 底部互动条：左侧「被 AI 引用 N 次」/ 删除，右侧 赞·评论·收藏 -->
  <view class="pc-foot">
    <view class="pc-foot-left">
      <text wx:if="{{showCited}}" class="pc-cited">被 AI 引用 {{post.citedCount || 0}} 次</text>
      <view wx:if="{{manageable === 'manage'}}" class="pc-act pc-act-danger" catchtap="onDelete">删除</view>
    </view>
    <view class="pc-acts">
      <view class="pc-act" catchtap="onLike">
        <icon name="{{post.liked ? 'heart-on' : 'heart'}}" size="36"/>
        <text class="pc-num {{post.liked ? 'pc-num-on' : ''}}">{{likeText}}</text>
      </view>
      <view class="pc-act">
        <icon name="comment" size="36"/>
        <text class="pc-num">{{commentText}}</text>
      </view>
      <view wx:if="{{showFav}}" class="pc-act" catchtap="onFav">
        <icon name="{{post.faved ? 'star-on' : 'star'}}" size="36"/>
        <text class="pc-num {{post.faved ? 'pc-num-on' : ''}}">{{favText}}</text>
      </view>
    </view>
  </view>
</view>
