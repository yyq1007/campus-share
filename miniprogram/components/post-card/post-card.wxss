/* 卡片自持样式（重要）：组件默认样式隔离，app.wxss 的 .card 类不生效——
   白底/阴影必须在此显式声明，否则卡片透明、与页面渐变底无法区分。
   2px 淡紫描边 + 白底 + 圆角 + 紫晕阴影 */
.pc {
  position: relative;
  padding: 28rpx 28rpx 0;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
}

/* ---------- 头部：头像 + 昵称/时间 ---------- */
.pc-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
/* 匿名糖果色头像：按帖子 id 取色（见 post-card.js），不再是人像照片 */
.pc-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-brand);
}
.av-1 { background: var(--avatar-1); }
.av-2 { background: var(--avatar-2); }
.av-3 { background: var(--avatar-3); }
.av-4 { background: var(--avatar-4); }
.av-5 { background: var(--avatar-5); }

.pc-main { flex: 1; min-width: 0; }
.pc-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 状态角标（我的分享：审核中/已发布/已驳回/已下线）：占「热门」的位置 */
.pc-status {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}
.pc-status.st-published { background: var(--brand-100); color: var(--brand-700); }
.pc-status.st-pending { background: var(--warn-bg); color: var(--warning-text); }
.pc-status.st-rejected,
.pc-status.st-hidden { background: var(--coral-bg); color: var(--coral-text); }
.pc-status.st-expired { background: var(--warn-bg); color: var(--warning-text); }

.pc-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--text-3);
}
.pc-expired { color: var(--warning-text); }

/* ---------- 正文 ---------- */
.pc-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pc-excerpt {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.62;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  word-break: break-word;
}

/* ---------- 媒体（在正文下方） ---------- */
.pc-media {
  position: relative;
  margin-top: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.pc-cover {
  display: block;
  width: 100%;
  height: 400rpx;
  background: var(--bg-field);
}
.pc-play {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--white-a90);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 8rpx;
}

/* ---------- 话题（板块）：描边胶囊 ---------- */
.pc-topic {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
}
.pc-topic-text { font-size: 22rpx; color: var(--text-2); }

/* ---------- 底部互动条（通栏分隔线） ---------- */
.pc-foot {
  margin: 24rpx -28rpx 0;
  padding: 0 28rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid var(--border);
}
.pc-foot-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}
.pc-cited {
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-acts {
  display: flex;
  align-items: center;
  gap: 48rpx;
  flex-shrink: 0;
}
.pc-act { display: flex; align-items: center; gap: 8rpx; }
.pc-act-danger { font-size: 24rpx; color: var(--coral-text); }
.pc-num { font-size: 24rpx; color: var(--text-3); }
.pc-num-on { color: var(--brand-700); font-weight: 600; }

/* ---------- 周报卡（weeklyDigest 置顶） ----------
   不分板块的一篇周报：紫色渐变头 + AI 总结 + 精选帖列表。
   颜色全部走 theme.wxss 令牌（V-01 零硬编码色值）。 */
.pc-digest {
  padding: 0;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
  position: relative;
}
.pc-digest-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx 20rpx;
  background: var(--brand-gradient);
}
.pc-digest-badge {
  font-size: 24rpx;
  line-height: 1;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--white-a90);
  color: var(--brand-700);
  flex-shrink: 0;
}
.pc-digest-count {
  font-size: var(--fs-caption);
  color: var(--text-on-brand);
  opacity: 0.85;
  flex-shrink: 0;
}
.pc-digest-summary {
  padding: 28rpx 32rpx 8rpx;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--text-1);
}
.pc-digest-list { padding: 8rpx 32rpx 0; }
.pc-digest-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}
.pc-digest-item:last-child { border-bottom: none; }
.pc-digest-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-50);
  color: var(--brand-700);
  font-size: var(--fs-caption);
  flex-shrink: 0;
}
.pc-digest-item-main { flex: 1; overflow: hidden; }
.pc-digest-item-title {
  font-size: var(--fs-body);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-digest-item-meta {
  display: flex;
  gap: 16rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  margin-top: 4rpx;
}
.pc-digest-item-board { color: var(--brand-600); }
.pc-digest-foot {
  padding: 16rpx 32rpx 24rpx;
  font-size: var(--fs-micro);
  color: var(--text-faint);
}
