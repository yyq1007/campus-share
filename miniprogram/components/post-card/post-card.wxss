/* 卡片自持样式（重要）：组件默认样式隔离，app.wxss 的 .card 类不生效——
   白底/阴影必须在此显式声明，否则卡片透明、与页面渐变底无法区分。
   3rpx 淡紫描边 + 白底 + 圆角 + 紫晕阴影，严格对齐参考图 */
.pc {
  padding: 0;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
  /* 状态角标的定位参照（角标挂在卡片层，不在封面层） */
  position: relative;
}
.pc-cover-wrap { position: relative; }
.pc-cover {
  width: 100%;
  height: 446rpx;
  display: block;
  background: var(--bg-field);
}
.pc-play {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--white-a90);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 8rpx;
}
.pc-expired {
  position: absolute;
  top: 20rpx; left: 20rpx;
  z-index: 2;
  background: var(--warn-bg);
  color: var(--warn-fg, var(--warning-text));
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}
/* 状态角标（我的分享：审核中/已发布/已驳回/已下线）
   定位在卡片右上角（不是封面左上角）：
   无封面图时封面容器高度为 0，角标若挂在封面层会溢出压到标题上。 */
.pc-status {
  position: absolute;
  top: 20rpx; right: 20rpx;
  z-index: 2;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}
.pc-status.st-published { background: var(--brand-100); color: var(--brand-700); }
.pc-status.st-pending { background: var(--warn-bg); color: var(--warning-text); }
.pc-status.st-rejected,
.pc-status.st-hidden { background: var(--coral-bg); color: var(--coral-text); }
.pc-status.st-expired { background: var(--warn-bg); color: var(--warning-text); }
.pc-body { padding: 24rpx 28rpx 28rpx; }
.pc-tags { margin-bottom: 12rpx; }
.pc-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pc-excerpt {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pc-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pc-meta-left { font-size: 24rpx; color: var(--text-3); }
.pc-actions { display: flex; gap: 32rpx; align-items: center; }
.pc-act { display: flex; align-items: center; gap: 8rpx; }
.pc-act-danger { font-size: 24rpx; color: var(--coral-text); }
.pc-act-mute { font-size: 24rpx; color: var(--text-3); }
.pc-num { font-size: 24rpx; color: var(--text-3); }
.pc-num-on { color: var(--brand-700); font-weight: 600; }

/* ---------- 周报卡（weeklyDigest 置顶） ----------
   不分板块的一篇周报：紫色渐变头 + AI 总结 + 精选帖列表。
   颜色全部走 theme.wxss 令牌（V-01 零硬编码色值）。 */
.pc-digest {
  padding: 0;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
  position: relative;
}
.pc-digest-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx 20rpx;
  background: var(--brand-gradient);
}
.pc-digest-badge {
  font-size: 24rpx;
  line-height: 1;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--white-a90);
  color: var(--brand-700);
  flex-shrink: 0;
}
.pc-digest-count {
  font-size: var(--fs-caption);
  color: var(--text-on-brand);
  opacity: 0.85;
  flex-shrink: 0;
}
.pc-digest-summary {
  padding: 28rpx 32rpx 8rpx;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--text-1);
}
.pc-digest-list { padding: 8rpx 32rpx 0; }
.pc-digest-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}
.pc-digest-item:last-child { border-bottom: none; }
.pc-digest-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-50);
  color: var(--brand-700);
  font-size: var(--fs-caption);
  flex-shrink: 0;
}
.pc-digest-item-main { flex: 1; overflow: hidden; }
.pc-digest-item-title {
  font-size: var(--fs-body);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-digest-item-meta {
  display: flex;
  gap: 16rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  margin-top: 4rpx;
}
.pc-digest-item-board { color: var(--brand-600); }
.pc-digest-foot {
  padding: 16rpx 32rpx 24rpx;
  font-size: var(--fs-micro);
  color: var(--text-faint);
}
