<view wx:if="{{state === 'loading'}}" class="ps">
  <block wx:if="{{type === 'list'}}">
    <view class="card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk sk-cover"></view>
      <view class="sk sk-line" style="width: 78%"></view>
      <view class="sk sk-line" style="width: 52%"></view>
    </view>
  </block>
  <block wx:elif="{{type === 'detail'}}">
    <view class="sk sk-hero"></view>
    <view class="ps-pad">
      <view class="sk sk-line" style="width: 64%"></view>
      <view class="sk sk-line"></view>
      <view class="sk sk-line" style="width: 88%"></view>
      <view class="sk sk-line" style="width: 40%"></view>
    </view>
  </block>
  <block wx:elif="{{type === 'chat'}}">
    <view class="sk sk-bubble" style="width: 60%"></view>
    <view class="sk sk-bubble sk-right" style="width: 44%"></view>
    <view class="sk sk-bubble" style="width: 70%"></view>
  </block>
  <!-- 慢加载兜底：6s 仍在 loading → 提示 + 可重试，避免像卡死 -->
  <view wx:if="{{slow}}" class="ps-slow">
    <text class="ps-slow-text">加载有点慢，可能是网络不稳定</text>
    <view class="ps-slow-retry" bindtap="onRetry">重新加载</view>
  </view>
</view>

<view wx:elif="{{state === 'empty' || state === 'offline'}}" class="ps ps-center">
  <icon name="{{state === 'offline' ? 'empty-cloud' : icon}}" size="160"/>
  <view class="ps-main">{{state === 'offline' ? '网络不可用' : emptyText}}</view>
  <view wx:if="{{emptySub && state !== 'offline'}}" class="ps-sub">{{emptySub}}</view>
  <view wx:if="{{btnText && state !== 'offline'}}" class="btn-primary ps-btn" bindtap="onAction">{{btnText}}</view>
  <view wx:if="{{state === 'offline'}}" class="ps-sub">请检查网络后重试</view>
</view>

<view wx:elif="{{state === 'error'}}" class="ps ps-center">
  <icon name="empty-cloud" size="160"/>
  <view class="ps-main">加载失败</view>
  <view class="btn-secondary ps-btn" bindtap="onRetry">重试</view>
</view>
