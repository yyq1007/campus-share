.ps { padding: 32rpx; }
.ps-center {
  padding: 140rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.ps-main { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-top: 12rpx; }
.ps-sub { font-size: 24rpx; color: var(--text-3); }
.ps-btn { padding: 18rpx 56rpx; margin-top: 16rpx; }
.ps-pad { padding: 32rpx; display: flex; flex-direction: column; gap: 20rpx; }

/* 骨架 / 骨架卡：组件默认 styleIsolation=isolated，app.wxss 的 .sk / .card
   **不会作用到组件内部** —— v4 因此骨架屏实际是透明的（表现为「加载白屏」）。
   v5 在此自持声明，shimmer 复用既有色对（skeleton-base → skeleton-peak）。 */
.card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.sk {
  border-radius: 12rpx;
  background: linear-gradient(90deg,
    var(--skeleton-base) 25%,
    var(--skeleton-peak) 50%,
    var(--skeleton-base) 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s linear infinite;
}
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 封面骨架按 v5 的 3:2 比例（原 400rpx 与新卡比例不符） */
.sk-cover { width: 100%; height: 500rpx; margin-bottom: 20rpx; }
.sk-line { height: 32rpx; margin-top: 16rpx; }
.sk-hero { width: 100%; height: 500rpx; border-radius: 0; }
.sk-bubble { height: 88rpx; margin-bottom: 24rpx; }
.sk-right { margin-left: auto; }

/* 慢加载提示（loading 超 6s 显示） */
.ps-slow { margin-top: 32rpx; text-align: center; }
.ps-slow-text { font-size: 24rpx; color: var(--text-3); }
.ps-slow-retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 14rpx 44rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--bg-elevated);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}
