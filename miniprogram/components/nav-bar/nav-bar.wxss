.nav-wrap { position: relative; width: 100%; }
.nav-bg {
  position: absolute;
  left: 0; top: 0; right: 0;
  background: var(--bg-elevated);
  box-shadow: 0 8rpx 24rpx var(--brand-a04);
  z-index: 0;
}
.nav-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}
.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-dark {
  background: var(--scrim-soft);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  color: var(--text-1);
}
.nav-title-light { color: var(--text-on-brand); }
