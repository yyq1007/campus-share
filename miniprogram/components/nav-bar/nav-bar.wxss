.nav-wrap { position: relative; width: 100%; }
/* 导航条底：与页面渐变同色系的半透明层，不铺纯白。
   分隔线用 inset 阴影画（不占高度，避免把导航行往下推 1rpx）。 */
.nav-bg {
  position: absolute;
  left: 0; top: 0; right: 0;
  background: var(--nav-glass);
  box-shadow: inset 0 -1rpx 0 var(--nav-glass-line);
  z-index: 0;
}
.nav-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}
.nav-back {
  position: absolute;
  left: 24rpx;
  /* 实际 top 由 wxml 内联的 navMid 决定（状态栏高度 + 导航行一半）。
     这里保留 50% 只作兜底：内联缺失时至少还在导航区域内。 */
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-dark {
  background: var(--scrim-soft);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  color: var(--text-1);
}
.nav-title-light { color: var(--text-on-brand); }
