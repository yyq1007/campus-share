.st {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: var(--radius-pill);
  padding: 6rpx 20rpx;
}
.st-pending, .st-expired { background: var(--warning-bg); color: var(--warning-text); }
.st-hidden { background: var(--bg-field); color: var(--text-3); }
.st-rejected { background: var(--error-bg); color: var(--error-text); }
