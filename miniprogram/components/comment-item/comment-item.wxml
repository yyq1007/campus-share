<view class="ci" bindlongpress="onLongPress">
  <user-avatar uid="{{comment.authorUid}}" size="72" />
  <view class="ci-main">
    <view class="ci-head">
      <text class="ci-name">匿名 #{{comment.floor}}</text>
      <text wx:if="{{comment.status === 'pending'}}" class="ci-pending">审核中</text>
      <text class="ci-time">{{timeText}}</text>
    </view>
    <view class="ci-content">{{comment.content}}</view>
    <view wx:if="{{showReply}}" class="ci-reply-btn" catchtap="onReply">回复</view>

    <view wx:if="{{comment.replies && comment.replies.length}}" class="ci-replies">
      <view class="ci-reply" wx:for="{{comment.replies}}" wx:key="id" wx:for-item="r">
        <view class="ci-reply-line" catchtap="onReplyItem" data-r="{{r}}">
          <text class="ci-reply-name">匿名 #{{r.floor}}</text>
          <text wx:if="{{r.replyToFloor}}" class="ci-reply-text"> 回复 匿名 #{{r.replyToFloor}}：</text>
          <text wx:else class="ci-reply-text">：</text>
          <text class="ci-reply-content">{{r.content}}</text>
        </view>
        <text class="ci-reply-time">{{replyTimes[r.id]}}</text>
      </view>
      <view wx:if="{{comment.replyCount > comment.replies.length}}" class="ci-expand" catchtap="onExpand">
        展开更多回复（{{comment.replyCount - comment.replies.length}}）
      </view>
    </view>
  </view>
</view>
