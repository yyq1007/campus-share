/* S2 板块页 */
.banner-wrap { margin-top: 16rpx; }
.banner {
  position: relative;
  height: 280rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--brand-100);
}
.banner-img { width: 100%; height: 100%; }
.banner-mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, var(--bg-a24) 0%, var(--brand-a30) 100%);
}
.banner-sticker {
  position: absolute;
  right: 28rpx; bottom: 28rpx;
}
.banner-title {
  position: absolute;
  left: 36rpx; bottom: 32rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-on-brand);
  text-shadow: 0 2rpx 8rpx var(--text1-a24);
}

.declaration {
  margin: 20rpx 8rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.count-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 8rpx 24rpx;
}
.count { font-size: 24rpx; color: var(--text-3); }

.load-more { text-align: center; font-size: 24rpx; color: var(--text-3); padding: 24rpx 0; }

/* ---- v4 设计稿对齐（追加覆盖） ---- */
.banner-sticker {
  left: 28rpx; right: auto; bottom: auto;
  top: 50%;
  transform: translateY(-50%);
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx var(--text1-a18);
}
.banner-text { position: absolute; left: 148rpx; top: 50%; transform: translateY(-50%); }
.banner-title { position: static; font-size: 40rpx; }
.banner-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--white-a92); }

/* ---- 底部分享条（板块内专属） ----
   样式参考校园频道：浅色胶囊占位 + 右侧图片按钮，整条点击进发布页。
   首页不放这条，首页仍用右下角悬浮发布按钮。 */
.share-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-top: 2rpx solid var(--border);
}
.share-bar-input {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: var(--radius-input);
  background: var(--bg-field);
}
.share-bar-ph { font-size: 28rpx; color: var(--text-3); }
.share-bar-img {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 列表底部留出分享条的高度，最后一张卡不被压住 */
.safe-bottom-bar { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
