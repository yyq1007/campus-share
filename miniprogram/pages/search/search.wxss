/* 搜索页 —— v4 令牌 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  /* 内容区：恢复统一渐变底 */
  background: var(--bg-gradient);
}
/* 顶部导航：胶囊行留空，返回键+搜索框+按钮在胶囊下方一行；顶栏浅紫底（用户指定） */
.nav {
  position: relative;
  z-index: 10;
  background: var(--brand-100);
  box-shadow: 0 8rpx 24rpx var(--brand-a04);
  padding-bottom: 20rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  box-shadow: var(--shadow-soft);
  border-radius: 32rpx;
  flex-shrink: 0;
}
.nav-btn-icon { width: 32rpx; height: 32rpx; }
.search-shell {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 28rpx;
  background: var(--bg-elevated);
  border-radius: 36rpx;
  box-shadow: var(--shadow-soft);
}
.search-icon { width: 32rpx; height: 32rpx; opacity: 0.5; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text-body); }
.ph { color: var(--text-faint); }
.search-go {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-on-brand, #FFFFFF);
  background: var(--primary);
  border-radius: 32rpx;
}

.card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: var(--bg-elevated);
  border-radius: 48rpx;
  box-shadow: var(--shadow-card);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; color: var(--text-strong); }
.card-clear { width: 32rpx; height: 32rpx; opacity: 0.4; }
.chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-body);
  background: var(--fill-soft);
  border-radius: 26rpx;
}
.chip-hot { color: var(--primary-deep); background: var(--primary-tint); }

.list { flex: 1; min-height: 0; }
.feed { padding: 24rpx 32rpx 0; }
.list-foot {
  padding: 20rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}
.pad { height: 180rpx; }
