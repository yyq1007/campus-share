<view class="page-bg"></view>

<!-- 页头：圆体标语（v5.2 去掉猫与云朵插画——纯大字更干净，也是设计稿 v5 的原样） -->
<view class="hero" style="padding-top:{{statusBarH + navH}}px">
  <view class="hero-inner">
    <view class="hero-title-wrap">
      <view class="hero-title">把好东西，</view>
      <view class="hero-title">留在这所学校</view>
    </view>
  </view>
</view>

<view class="page-pad body">
  <!-- v6 板块卡：整卡是抠出来的图片（含白盘、粘土图标、文字），和设计图一致 -->
  <scroll-view class="cat-row" scroll-x show-scrollbar="{{false}}">
    <view
      wx:for="{{cats}}" wx:key="key"
      class="cat-card {{board === item.key ? 'is-on' : ''}}"
      data-board="{{item.key}}"
      bindtap="onStickerTap"
      hover-class="cat-card-hover" hover-stay-time="60"
    >
      <image class="cat-card-img" src="{{item.img}}" mode="aspectFill" />
    </view>
  </scroll-view>

  <!-- 搜索框前置：从二级页提到首页常驻，强化「内容可检索」心智 -->
  <view class="search-pill" hover-class="search-pill-hover" hover-stay-time="80" bindtap="onSearchTap">
    <icon name="search-primary" size="36" />
    <text class="search-ph">搜好物 / 美食 / 资料…</text>
  </view>

  <!-- 引导行：AI 引导卡（v5 深紫实底浮起层，全屏唯一浓色） + 周报按钮 -->
  <view class="guide-row">
    <view class="ai-card" hover-class="ai-card-hover" hover-stay-time="80" bindtap="onAiTap">
      <view class="ai-badge">AI</view>
      <view class="ai-text">
        <view class="ai-main">有问题，问 AI 同学</view>
        <view class="ai-sub">好物、选课、美食都能问</view>
      </view>
      <view class="ai-arrow" />
    </view>
    <view class="digest-entry" bindtap="onDigestTap">
      <view class="digest-tile digest-tile-zhou">
        <image class="digest-char" src="/assets/icons/digest-zhou.png" mode="aspectFit" />
      </view>
      <view class="digest-tile digest-tile-bao">
        <image class="digest-char digest-char-bao" src="/assets/icons/digest-bao.png" mode="aspectFit" />
      </view>
    </view>
    <!-- 装饰星：压在 AI 卡右边框与周报按钮左上角的接缝处（pointer-events:none 不吃点击） -->
    <image class="guide-sparkle" src="/assets/deco/sparkle-cyan.png" mode="aspectFit" />
  </view>

  <!-- 信息流（板块筛选由上方胶囊行承担） -->
  <page-state wx:if="{{state === 'loading' || state === 'error' || state === 'empty'}}"
    state="{{state}}" type="list"
    emptyText="{{board === 'all' ? '还没有内容' : '这个板块还空着'}}"
    emptySub="{{board === 'all' ? '做第一个分享好物的同学吧' : ''}}"
    btnText="发布第一条分享"
    bind:retry="onRetry" bind:action="onEmptyAction"
  />
  <block wx:else>
    <!-- 双列网格（仿电商商品流：方形图 + 标题 + 互动底栏） -->
    <view class="feed-grid">
      <view class="feed-item" wx:for="{{list}}" wx:key="id">
        <post-card
          post="{{item}}"
          grid="{{true}}"
          bind:tap="onPostTap" bind:like="onLike" bind:fav="onFav"
        />
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">加载中…</view>
    <view wx:if="{{loadMoreError}}" class="load-more load-more-err" bind:tap="onLoadMoreRetry">加载失败，点击重试</view>
    <view wx:if="{{!hasMore && list.length > 2}}" class="load-more">没有更多了</view>
  </block>

  <view class="tab-page-bottom"></view>
</view>

<!-- FAB 发一条 -->
<view class="fab fab-tab" bindtap="onFab">
  <icon name="plus-white" size="40" />
</view>

<!-- 隐私协议门禁（未同意时全屏遮罩） -->
<privacy-gate />
