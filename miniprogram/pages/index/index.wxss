/* 抖音美好体（标题专用，子集化后仅含标题 11 个字）
   字体文件 2MB，全量放不进主包；这里只保留用到的字，内联成 base64 免加载延迟 */
@font-face {
  font-family: 'DouyinMeihao';
  src: url('data:font/woff;base64,') format('woff');
  font-weight: 400;
  font-display: swap;
}

/* S1 首页 */
/* 设计稿栅格：内容左右边距 20px = 40rpx
   v5.2：去掉猫与云朵插画（那套白色素材在浅底上没有轮廓，怎么调都脏），
   回到纯大字版头——这也是 UI v5 设计稿首页的原样。省下的高度直接让给信息流。 */
.hero {
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 20rpx;
}
.hero-inner { position: relative; }
.hero-title-wrap { padding-top: 20rpx; }
/* v6.6 标题改法：
   ① 去掉 font-title（KuaiLe 字体文件根本不存在，一直回退系统字，
      在 Windows/安卓上会落到雅黑 Bold，又粗又方）
   ② 字重 600 → 500：系统字体的 600 在多数平台会映射成 Bold，太重
   ③ 第二行用品牌紫，两行形成深浅对比，比整块黑字有层次 */
.hero-title {
  font-family: 'DouyinMeihao', -apple-system, 'PingFang SC', sans-serif;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1.32;
  letter-spacing: 1rpx;
  /* v6.7 文字渐变：紫 → 浅紫 → 天蓝，两行共用同一套色阶，读起来是连贯的一整块 */
  background: linear-gradient(118deg, var(--brand-700) 0%, var(--brand-500) 46%, var(--sky) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

/* 搜索胶囊（v5：从二级页提到首页常驻，紧跟在分类胶囊行下方） */
.search-pill {
  margin-bottom: 24rpx;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-elevated);
  border: 1rpx solid var(--card-border);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--press-duration) var(--press-ease),
              box-shadow var(--press-duration) var(--press-ease);
}
.search-pill-hover {
  transform: scale(var(--press-scale));
  box-shadow: var(--press-shadow-tight);
}
.search-ph { font-size: 28rpx; color: var(--text-3); }

.body { margin-top: 24rpx; }

/* ---------- v5 板块卡（仿参考图） ----------
   结构：圆角方形卡 = 上部彩色渐变 + 半透明玻璃球图标，下部同色系深色条 + 白字。
   四个卡刚好铺满一行（155×4 + 16×3 = 668rpx），加了新板块会自动变成可横向滚动。 */
.cat-row {
  white-space: nowrap;
  width: 100%;
  margin-top: 8rpx;
  margin-bottom: 26rpx;
}
/* ---------- v6 板块卡（参考图：浅糖果底 + 米白立体圆盘 + 深色字） ----------
   和 v5 的「深底白字」正好相反：这里底色浅、文字深，
   层次靠「软胶厚度」（顶部内高光 + 底部投影）而不是靠颜色对比。 */
/* ---------- v6 板块卡：整卡是图片（原图抠出，含白盘/粘土图标/文字） ----------
   卡片内的所有视觉都在图片里，CSS 只负责尺寸、圆角、投影和按压反馈。
   图片宽高比 192:222，所以卡片高 = 158 * 222/192 ≈ 183rpx。 */
.cat-card {
  display: inline-flex;
  width: 152rpx;
  height: 176rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  vertical-align: top;
  flex-shrink: 0;
  /* translateZ(0) 触发合成层：iOS 上 overflow:hidden 裁圆角对 <image> 常失效，
     图片会溢出到圆角外面，加合成层后裁切才正常 */
  transform: translateZ(0);
  box-shadow: 0 4rpx 12rpx var(--brand-a10);
  transition: transform var(--press-duration) var(--press-ease),
              box-shadow var(--press-duration) var(--press-ease);
}
/* 4 张卡：152×4 + 16×3 = 656rpx，可用宽 670rpx，留 14rpx 余量 */
.cat-card-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}
.cat-card-hover {
  transform: scale(var(--press-scale));
}
/* 选中态：上浮 + 投影略深（不加描边，描边在浅色卡上很突兀） */
.cat-card.is-on {
  box-shadow: 0 8rpx 18rpx var(--brand-a25);
  transform: translateY(-3rpx);
}

/* ---------- v5 AI 引导卡：深紫实底浮起层 ----------
   v4 是浅紫渐变底（和白卡同明度，抢不到焦点）。v5 改成深紫实底 +
   外投影：全屏唯一的浓色块，一眼就知道这是主入口。
   同时承接 postAssist（拍照发帖）入口，副标题说明它还能问答。 */
.ai-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 132rpx;
  border-radius: 32rpx;
  padding: 0 26rpx;
  background: linear-gradient(135deg,
    var(--ai-entry-grad-from) 0%,
    var(--ai-entry-grad-to) 100%);
  box-shadow: var(--ai-entry-shadow);
  transition: transform var(--press-duration) var(--press-ease),
              box-shadow var(--press-duration) var(--press-ease);
}
.ai-card-hover {
  transform: scale(var(--press-scale));
  box-shadow: var(--press-shadow-tight);
}
/* 深紫底上的白章：半透明白底 + 白字，替代 v4 的彩色径向渐变 */
.ai-badge {
  box-sizing: border-box;
  width: 76rpx; height: 76rpx;
  border-radius: 999rpx;
  background: var(--white-a18);
  border: 1rpx solid var(--white-a28);
  color: var(--text-on-brand);
  font-family: 'Agbalumo', 'KuaiLe', -apple-system, 'PingFang SC', sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  /* Agbalumo 行盒中心偏低，补 padding 让字形回到圆心 */
  padding-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ai-text { flex: 1; min-width: 0; }
.ai-main {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-on-brand);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ai-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--white-a78);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 深紫底上的 CTA 箭头：CSS 画右尖角（图标库只有紫/灰/墨色箭头，深底上看不清） */
.ai-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid var(--text-on-brand);
  border-right: 4rpx solid var(--text-on-brand);
  transform: rotate(45deg);
  margin-left: 4rpx;
}

/* 引导行：AI 卡（265×62） + 周报按钮（77×52）同一行 */
.guide-row {
  position: relative;            /* 装饰星以此定位，可溢出卡片边界 */
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
/* 右上角装饰星（设计稿约 33×33rpx，青色描边四角星，压在 AI 卡与周报按钮的接缝上）
   锚定在行右缘：星框右缘距行右缘 130rpx → 相对周报按钮左缘外扩 32rpx；
   顶部高出按钮 12rpx（设计稿星心距按钮顶 11rpx）。
   pointer-events 关掉，避免吃掉周报按钮的点击 */
.guide-sparkle {
  position: absolute;
  right: 130rpx;
  top: -12rpx;
  width: 60rpx;
  height: 60rpx;
  z-index: 2;
  pointer-events: none;
}
/* 周报按钮：容器 158×120 直角 + 横向浅薄荷→浅蓝渐变，最后 7% 收一条窄的深色边；
   两个白色竖椭圆（50×60：周左上、报右下）；字为得意黑渐变字（烘焙 PNG，见 assets/icons/digest-*.png） */
.digest-entry {
  position: relative;
  flex-shrink: 0;
  width: 158rpx;   /* 设计稿面板 79 */
  height: 120rpx;  /* 设计稿面板 60：比左侧 AI 卡（62）矮 2，垂直居中 */
  border-radius: 0; /* 设计标注直角 */
  overflow: hidden;
  /* 单层渐变：0%→93% 是底色过渡，93%→100% 才是收边，避免出现明显"条边" */
  background: linear-gradient(90deg,
    var(--digest-btn-grad-1) 0%,
    var(--digest-btn-grad-2) 93%,
    var(--digest-edge) 100%);
}
.digest-tile {
  position: absolute;
  width: 50rpx;    /* 设计稿实测 49.7×59.5：竖向椭圆，不是正圆 */
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--digest-tile-bg);
}
/* 椭圆位置按设计稿：周 left 18.7 / top 22.2，报 left 81.7 / top 40.2 */
.digest-tile-zhou {
  left: 19rpx;
  top: 22rpx;
}
.digest-tile-bao {
  left: 82rpx;
  top: 40rpx;
}
/* 渐变字 PNG（8x 烘焙，含渐变与字形）；两字同一字号，宽高按各自字形比例。
   得意黑是斜体，"周"的撇、"报"的扌 都向左下甩出包围盒，bbox 居中会让字身看起来右偏，
   所以按设计稿把墨迹盒整体左挪（周 3.4、报 1.6），让字身落在椭圆圆心 */
.digest-char {
  position: relative;
  left: -3.4rpx;
  width: 42.6rpx;
  height: 52.2rpx;
}
.digest-char-bao {
  left: -1.6rpx;
  width: 41.1rpx;
  height: 54rpx;
}

/* ---------- 信息流：多列瀑布流 ----------
   用 column-count 而不是 flex 两列：卡片高度本来就不一样（有图 / 无图文字卡），
   flex 会被行内最高卡撑齐、下方留空，多列才能自然错落。 */
.feed-grid {
  column-count: 2;
  column-gap: 20rpx;
}
.feed-item {
  width: 100%;              /* 多列里宽度由列决定，不能写 calc，否则溢出 */
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  page-break-inside: avoid;
  margin-bottom: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 24rpx 0;
}
.load-more-err { color: var(--error-text); }
