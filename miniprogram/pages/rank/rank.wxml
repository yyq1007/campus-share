<!--S10 榜单：热度榜（长期累计）/ 新秀榜（近 7 天）+ 板块筛选 + 名次列表 -->
<view class="page">
  <!-- 页头（与问答页同构：导航标题 + 副标） -->
  <view class="hero" style="padding-top:{{statusBarH}}px">
    <view class="hero-nav" style="height:{{navH}}px">
      <view class="hero-title">榜单</view>
    </view>
    <view class="hero-sub">按点赞和收藏排名，收藏权重更高</view>
  </view>

  <view class="page-pad">
    <!-- 一级 Tab：热度榜 / 新秀榜 -->
    <view class="rk-tabs">
      <view class="rk-tab {{tab === 'hot' ? 'on' : ''}}" data-tab="hot" bindtap="onTabTap">热度榜</view>
      <view class="rk-tab {{tab === 'fresh' ? 'on' : ''}}" data-tab="fresh" bindtap="onTabTap">新秀榜</view>
    </view>

    <!-- 板块筛选：仅热度榜显示（新秀榜为全校新帖混排） -->
    <view wx:if="{{tab === 'hot'}}" class="rk-chips">
      <view wx:for="{{boards}}" wx:key="key"
            class="rk-chip {{board === item.key ? 'on' : ''}}"
            data-board="{{item.key}}" bindtap="onBoardTap">{{item.label}}</view>
    </view>

    <page-state wx:if="{{state !== 'success'}}"
      state="{{state}}" type="list"
      emptyText="还没有上榜内容"
      emptySub="{{tab === 'fresh' ? '最近 7 天发帖的同学还没上榜' : '去给你觉得好的分享点个赞吧'}}"
      bind:retry="onRetry"
    />

    <block wx:else>
      <view class="rk-item" wx:for="{{list}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onPostTap">
        <view class="rk-no {{item.rank <= 3 ? 'rk-no-' + item.rank : ''}}">{{item.rank}}</view>
        <image wx:if="{{item.cover}}" class="rk-cover" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="rk-cover rk-cover-ph" />
        <view class="rk-body">
          <view class="rk-title">{{item.title || item.excerpt || '无标题'}}</view>
          <view class="rk-meta">
            <text wx:if="{{tab === 'hot' && item.boardLabel}}" class="rk-board">{{item.boardLabel}}</text>
            <text class="rk-num">赞 {{item.likeCount}}</text>
            <text class="rk-num">藏 {{item.favCount}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{updatedText}}" class="rk-updated">{{updatedText}}</view>
    </block>

    <view class="tab-page-bottom"></view>
  </view>
</view>

<!-- 隐私协议门禁：与首页/板块页同款，未同意时盖住整页 -->
<privacy-gate />
