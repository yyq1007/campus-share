/* 关于页 —— v4 令牌 */
.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: var(--bg-gradient);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}
.nav-btn-icon { width: 32rpx; height: 32rpx; }
.nav-title { font-size: 34rpx; font-weight: 600; color: var(--text-strong); }
.nav-ph { width: 64rpx; }

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.hero-deco { width: 180rpx; height: 180rpx; }
.hero-name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-strong);
}
.hero-desc { margin-top: 12rpx; font-size: 26rpx; color: var(--text-soft); }
.hero-ver {
  margin-top: 16rpx;
  padding: 6rpx 24rpx;
  font-size: 22rpx;
  color: var(--primary-deep);
  background: var(--bg-elevated);
  border-radius: 24rpx;
}

.card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: var(--bg-elevated);
  border-radius: 48rpx;
  box-shadow: var(--shadow-card);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 24rpx;
}
.rule-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.rule-row:last-child { margin-bottom: 0; }
.rule-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  flex-shrink: 0;
  background: var(--primary);
  border-radius: 6rpx;
}
.rule-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body);
}

/* 协议入口行 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}
.link-row:last-child { border-top: none; }
.link-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-body);
}
.link-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.foot-note {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}
