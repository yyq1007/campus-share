<!--周报列表：本周精选 / 往期周报 两组，每期一张白胶囊卡（Alkatra 日期 + 精选条数 + 箭头） -->

<!-- 单期卡片：两组共用，避免两处结构各改一套导致不一致 -->
<template name="issue-card">
  <view
    class="issue"
    style="animation-delay:{{delay}}ms"
    hover-class="issue-press" hover-stay-time="90"
    data-id="{{id}}"
    bind:tap="onIssueTap"
  >
    <text class="issue-date">{{dateDot}}</text>
    <text class="issue-count">{{itemCount}}条精选</text>
    <icon name="chevron-right-primary" size="30" />
  </view>
</template>

<view class="page">
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-inner" style="height:{{navH}}px">
      <view class="nav-btn" bind:tap="onBack" hover-class="nav-btn-press" hover-stay-time="80">
        <image class="nav-btn-icon" src="/assets/icons/arrow-left.png" mode="aspectFit" />
      </view>
      <text class="nav-title">周报</text>
    </view>
  </view>

  <view class="head-sub">每周一 09:00 更新 · 精选上周校园好帖</view>

  <!-- 加载：三条骨架（与真实卡同高，避免出数据时跳动） -->
  <view wx:if="{{state === 'loading'}}" class="list">
    <view class="sk-card" wx:for="{{[1, 2, 3]}}" wx:key="*this" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{state === 'empty'}}" class="state">
    <image class="state-icon" src="/assets/deco/cloud.png" mode="aspectFit" />
    <view class="state-title">还没有周报</view>
    <view class="state-sub">每周一会自动整理上一周的精选内容</view>
  </view>

  <!-- 失败 -->
  <view wx:elif="{{state === 'error'}}" class="state">
    <image class="state-icon" src="/assets/deco/cloud.png" mode="aspectFit" />
    <view class="state-title">加载失败了</view>
    <view class="state-btn" bind:tap="onRetry" hover-class="state-btn-press">点一下重试</view>
  </view>

  <!-- 两组：最新一期 = 本周精选；其余 = 往期周报 -->
  <view wx:else class="sections">
    <view wx:if="{{latest}}" class="sec">
      <view class="sec-head">
        <icon name="ai-sparkle" size="30" />
        <text class="sec-title">本周精选</text>
        <text class="sec-hint">最新一期</text>
      </view>
      <view class="issues">
        <template is="issue-card" data="{{...latest, delay: 0}}" />
      </view>
    </view>

    <view wx:if="{{past.length}}" class="sec">
      <view class="sec-head">
        <icon name="ai-sparkle" size="30" />
        <text class="sec-title">往期周报</text>
      </view>
      <view class="issues">
        <block wx:for="{{past}}" wx:key="id">
          <template is="issue-card" data="{{...item, delay: (index + 1) * 45}}" />
        </block>
      </view>
    </view>
  </view>

  <privacy-gate />
</view>
