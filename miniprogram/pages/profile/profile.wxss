/* S6 我的 —— v4 软萌手账（设计稿实测：头像 88px / 统计卡 335×84 / 菜单卡 335×280） */
.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: var(--bg-gradient);
}

/* ---------- 渐变页头 ---------- */
.hero {
  padding: 0 40rpx 24rpx;
}
.hero-nav { display: flex; align-items: center; }
.hero-title { font-size: 40rpx; font-weight: 600; color: var(--text-strong); }

/* ---------- 状态 ---------- */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 80rpx;
}
.skeleton {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(90deg, var(--bg-elevated) 0%, var(--skeleton-hi) 50%, var(--bg-elevated) 100%);
  border-radius: 48rpx;
}
.state-icon { width: 160rpx; height: 160rpx; }
.state-text { margin-top: 20rpx; font-size: 28rpx; color: var(--text-soft); }
.state-btn {
  margin-top: 32rpx;
  padding: 0 64rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-on-brand);
  background: var(--primary);
  border-radius: 38rpx;
}
.state-btn::after { border: none; }

/* ---------- 个人区（居中） ---------- */
.user-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}
.avatar-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}
.avatar-img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 88rpx;
}
.avatar-ph {
  width: 176rpx;
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-display-xl);
  font-weight: 500;
  color: var(--text-on-brand);
  background: var(--brand-gradient);
  border-radius: 88rpx;
  box-shadow: var(--shadow-card);
}
.avatar-cam {
  position: absolute;
  right: -8rpx;
  bottom: -4rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border-radius: 36rpx;
  box-shadow: var(--shadow-soft);
}
.avatar-cam-icon { width: 36rpx; height: 36rpx; }
.user-nick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-strong);
}
.user-edit { width: 28rpx; height: 28rpx; opacity: 0.4; }
.user-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--text-soft); }

/* ---------- 统计卡（335×84 → 670×168rpx，描边） ---------- */
.stat-card {
  display: flex;
  align-items: center;
  margin: 32rpx 40rpx 0;
  padding: 0;
  height: 168rpx;
  background: var(--bg-elevated);
  border: 2rpx solid var(--brand-200);
  border-radius: 44rpx;
  box-shadow: none;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-num {
  font-size: var(--fs-display-l);
  font-weight: 600;
  line-height: 1.2;
  color: var(--primary-deep);
}
.stat-label { font-size: 26rpx; color: var(--text-soft); }

/* ---------- 菜单卡（335×280 → 670×560rpx，描边） ---------- */
.menu-card {
  margin: 32rpx 40rpx 0;
  padding: 0 32rpx;
  background: var(--bg-elevated);
  border: 2rpx solid var(--brand-200);
  border-radius: 44rpx;
  box-shadow: none;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 30rpx;
  height: 112rpx;
}
.menu-item + .menu-item {
  border-top: 2rpx solid var(--border);
}
.menu-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.menu-text { flex: 1; font-size: 30rpx; color: var(--text-1); }
.menu-arrow { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.menu-dot {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-on-brand);
  background: var(--coral);
  border-radius: 16rpx;
}
.menu-role {
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--coral-text);
  background: var(--coral-bg);
  border-radius: 20rpx;
}

/* ---------- 退出登录 ---------- */
.logout {
  margin-top: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--coral-text);
}
.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}
