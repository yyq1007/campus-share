/* S4 详情页 —— v4 软萌手账令牌 */
.page {
  min-height: 100vh;
  background: var(--bg-gradient);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 导航 ---------- */
.nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: transparent;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: flex-start; /* 分享钮随返回钮靠左，右侧留白避让系统胶囊 */
  gap: 20rpx;
  padding: 0 32rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}
.nav-btn-icon { width: 32rpx; height: 32rpx; }
.share-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated) !important;
  border-radius: 32rpx;
  border: none;
  box-shadow: var(--shadow-soft);
  line-height: 1;
}
.share-btn::after { border: none; }

/* ---------- 骨架 / 状态 ---------- */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 80rpx;
}
.skeleton {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(90deg, var(--bg-elevated) 0%, var(--skeleton-hi) 50%, var(--bg-elevated) 100%);
  border-radius: 48rpx;
  margin-bottom: 24rpx;
}
.skeleton.short { height: 180rpx; }
.state-icon { width: 160rpx; height: 160rpx; }
.state-text { margin-top: 20rpx; font-size: 28rpx; color: var(--text-soft); }
.state-btn {
  margin-top: 32rpx;
  padding: 0 64rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-on-brand);
  background: var(--primary);
  border-radius: 38rpx;
}
.state-btn::after { border: none; }

/* ---------- 正文区（设计稿：无白卡，直接排在渐变底上，左右 20px） ---------- */
/* ---------- v5 封面全出血（3:2 = 750×500rpx） ---------- */
.hero-media {
  position: relative;
  width: 100%;
  background: var(--bg-field);
}
.hero-gallery {
  width: 100%;
  height: 500rpx;
}
.hero-img {
  display: block;
  width: 100%;
  height: 500rpx;
}
/* 单图：竖拍长图不占满整屏，居中裁切，点开可看原图 */
.hero-img.solo {
  height: 500rpx;
  max-height: 56vh;
}
.hero-video {
  width: 100%;
  height: 500rpx;
}
.hero-dots {
  position: absolute;
  right: 24rpx;
  bottom: 72rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--scrim-soft);
  color: var(--text-on-brand);
  font-size: 22rpx;
}

/* ---------- v5 白卡下沉：负边距上移，盖住封面下缘 ---------- */
.detail-card-lift {
  position: relative;
  z-index: 2;
  margin: -48rpx 24rpx 0;
  padding: 28rpx 28rpx 8rpx;
  background: var(--bg-elevated);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-shadow: var(--shadow-card);
}
/* 无封面 / 周报：保持透明排版（不压白底，避免出现多余空白卡） */
.detail-card-plain {
  margin: 20rpx 40rpx 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
}
/* 作者行（信息流排版）：头像 + 昵称/时间 + 板块胶囊 */
.author-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.author-row .avatar {
  width: 72rpx;
  height: 72rpx;
  font-size: 30rpx;
}
.author-main { flex: 1; min-width: 0; }
.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}
.author-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}
.board-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 24rpx;
  /* v6.3：三个板块统一成「浅紫底 + 深紫字」
     原来是薄荷/天蓝/珊瑚实底白字，在紫色主色下三种饱和色一起跳，
     反而抢标题的注意力。分类只是标识，不需要三个颜色抢戏。 */
  background: var(--brand-100);
  color: var(--brand-800);
}
.board-mint { background: var(--brand-100); }
.board-sky { background: var(--brand-100); }
.board-coral { background: var(--brand-100); }
.detail-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-strong);
}

/* ---------- 图集 ---------- */
.gallery {
  margin-top: 0;   /* 顶部间距由 .gallery-wrap 统一给，避免叠加 */
  height: 420rpx;
  border-radius: 32rpx;
  overflow: hidden;
}
.gallery-img {
  width: 100%;
  height: 420rpx;
  border-radius: 32rpx;
}
/* 单图：固定高度居中裁切展示（2026-11-16 用户反馈竖拍长图占满整屏像被拉长），
   点图可进 wx.previewImage 看完整原图 */
.gallery-img.solo {
  display: block;
  height: 560rpx;
  max-height: 60vh;
}
.gallery-video {
  width: 100%;
  height: 420rpx;
  border-radius: 32rpx;
}
.gallery-dots {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* ---------- 正文 ---------- */
.detail-content {
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-body);
  white-space: pre-wrap;
}

/* ---------- 字段卡 ---------- */
/* v5 字段卡：灰底压灰字（label 灰 / value 深墨保证可读），行间发丝分隔 */
.field-card {
  margin-top: 24rpx;
  padding: 0 24rpx;
  background: var(--bg-field);
  border-radius: 24rpx;
}
.field-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.field-row:last-child { border-bottom: none; }
.field-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}
.field-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.field-copy { width: 26rpx; height: 26rpx; opacity: 0.45; flex-shrink: 0; }

/* ---------- 链接卡 ---------- */
.link-card {
  margin-top: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--fill-soft);
  border-radius: 24rpx;
}
.link-card-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.link-card-main { flex: 1; min-width: 0; }
.link-card-host {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-strong);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.link-card-tip { margin-top: 4rpx; font-size: 22rpx; color: var(--text-soft); }
.link-arrow { width: 28rpx; height: 28rpx; opacity: 0.4; }

/* ---------- 评论（设计稿：无白卡，直接排在渐变底上） ---------- */
.comment-card {
  margin: 40rpx 40rpx 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
}
.comment-head { display: flex; align-items: baseline; gap: 12rpx; }
.comment-title { font-size: 36rpx; font-weight: 600; color: var(--text-strong); }
.comment-num { font-size: 36rpx; font-weight: 600; color: var(--text-strong); }
.comment-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-faint);
}
.comment-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-brand);
  border-radius: 50%;
}
.avatar-1 { background: var(--avatar-1); }
/* 本人头像（isMine 时渲染），尺寸对齐糖果色头像 */
.avatar-img { background: var(--bg-field); }
.avatar-2 { background: var(--avatar-2); }
.avatar-3 { background: var(--avatar-3); }
.avatar-4 { background: var(--avatar-4); }
.avatar-5 { background: var(--avatar-5); }
.comment-main { flex: 1; min-width: 0; }
.comment-meta { display: flex; align-items: center; gap: 12rpx; }
.comment-nick { font-size: 30rpx; font-weight: 600; color: var(--text-strong); }
.comment-mine {
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  color: var(--primary-deep);
  background: var(--primary-tint);
  border-radius: 12rpx;
}
.comment-time { margin-left: auto; font-size: 24rpx; color: var(--text-faint); }
.comment-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text-1);
  word-break: break-all;
}
.comment-reply-btn {
  margin-top: 10rpx;
  align-self: flex-start;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--brand-50);
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}
.comment-replies {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--primary-tint);
  border-radius: 20rpx;
}
.comment-reply + .comment-reply { margin-top: 14rpx; }
.comment-reply-line { font-size: 26rpx; line-height: 1.6; color: var(--text-1); }
.comment-reply-name { font-weight: 600; color: var(--primary-deep); }
.comment-reply-seg { color: var(--text-3); }
.comment-reply-content { word-break: break-all; }
.comment-reply-time { margin-top: 4rpx; font-size: 22rpx; color: var(--text-3); }
.comment-more {
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
}
.page-bottom-pad { height: 200rpx; }

/* ---------- 底部互动栏（设计稿：白条 375×48 r=11px，输入框 #E5EBF3 + 3 个线性图标） ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 60rpx;
  padding: 12rpx 40rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: var(--shadow-soft);
}
.action-input {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  background: var(--brand-100);
  border-radius: 36rpx;
}
.action-input-field { flex: 1; font-size: 26rpx; color: var(--text-body); }
.ph { color: var(--text-faint); }
/* v5 互动条胶囊化：激活态才上底色（未激活透明，避免底部栏拥挤）
   喜欢 = 珊瑚红胶囊，收藏 = 奶黄橙胶囊，两者色相区分 */
.action-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--text-soft);
  transition: background var(--press-duration) var(--press-ease),
              color var(--press-duration) var(--press-ease);
}
.action-item.is-on {
  color: var(--coral-text);
  background: var(--coral-bg);
}
.action-item.is-on-fav {
  color: var(--sun-text);
  background: var(--sun-bg);
}
.action-icon { width: 40rpx; height: 40rpx; }

/* ---------- 收藏星标跳动 ----------
   幅度比爱心更大（星标更小，动作不大看不出来），旋转方向相反以便区分。 */
.star-beat {
  animation: star-beat 0.54s cubic-bezier(0.22, 0.9, 0.3, 1);
  transform-origin: center center;
  will-change: transform;
}

@keyframes star-beat {
  0% {
    transform: scale(1) rotate(0deg);
  }
  26% {
    transform: scale(1.42) rotate(14deg);
  }
  50% {
    transform: scale(0.90) rotate(-8deg);
  }
  72% {
    transform: scale(1.12) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

/* ---------- 点赞跳动爱心 ----------
   与 icon 组件内的 .heart-beat 同一套节奏：先弹到 1.35 倍并轻微左倾 →
   回弹到 0.92 倍 → 稳定回到 1。「过冲再回落」是跳动手感的关键。
   keyframes 末态必须回到 scale(1)，否则心形会留在放大态。 */
.heart-beat {
  animation: heart-beat 0.52s cubic-bezier(0.22, 0.9, 0.3, 1);
  transform-origin: center center;
  will-change: transform;
}

@keyframes heart-beat {
  0% {
    transform: scale(1) rotate(0deg);
  }
  28% {
    transform: scale(1.35) rotate(-9deg);
  }
  52% {
    transform: scale(0.92) rotate(5deg);
  }
  74% {
    transform: scale(1.08) rotate(-2deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}
/* 发送键：仅在有输入内容时出现（设计稿静态态无发送按钮，键盘 confirm 亦可发送） */
.action-send {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-on-brand);
  background: var(--primary);
  border-radius: 36rpx;
}

/* ---------- 回复提示 ---------- */
.reply-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--primary-deep);
  background: var(--primary-tint);
  border-radius: 24rpx;
}
.reply-close { width: 26rpx; height: 26rpx; }

/* ---- v4 设计稿对齐（追加覆盖） ---- */
/* v5：图集已改为页首全出血封面（.hero-media），旧卡内图集样式保留但不再引用 */
.board-chip { display: inline-flex; align-items: center; gap: 8rpx; }
.ai-cite-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(100deg, var(--brand-50) 0%, var(--bg-elevated) 100%);
  border: 2rpx solid var(--brand-200);
  border-radius: 32rpx;
}
.ai-cite-text { font-size: 26rpx; font-weight: 600; color: var(--primary-deep); }

/* ---------- 周报正文（周报帖专属）----------
   正文按引用角标 [n] 切成「一段带序号的描述 → 一条帖子行」，一条一条往下排。
   序号在描述段开头（1. 2. 3.），帖子行里不再单独挂编号。
   颜色全部走 theme.wxss 令牌（V-01 零硬编码色值）。 */
/* 周报块本身不在 .detail-card 里，要自己撑出与正文相同的左右边距（40rpx） */
.digest-body { margin: 0 40rpx 32rpx; }
.digest-p {
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-body);
  white-space: pre-wrap;
}
/* 序号放在描述段开头（1. 2. 3.），帖子行里就不必再挂一个编号圆了 */
.digest-p-no {
  margin-right: 8rpx;
  color: var(--brand-700);
  font-weight: 600;
}
/* 帖子行：标题/信息 + 右侧缩略图 + 箭头，整行可点进原帖。
   详情页整体是「透明排版 + 浅紫渐变背景」，所以这里的块不能做成白卡：
   白底（哪怕 90% 半透）在这张浅紫渐变上仍然读作「贴了一张白纸」，跟正文两套质感。
   改成浅紫玻璃：brand-a10（10% 品牌紫）叠在渐变上——块底是带紫调的，不是白的，
   渐变能透下来，块的浓度又足够把它从背景里分出来；
   描边用帖子卡专用 card-border（同色系），阴影只留极淡一层负责「托起」。 */
.digest-ref {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--brand-a10);
  border: 2rpx solid var(--card-border);
  box-shadow: 0 4rpx 14rpx var(--brand-a06);
}
.digest-ref-main { flex: 1; overflow: hidden; }
.digest-ref-title {
  font-size: 30rpx;
  line-height: 1.42;
  color: var(--text-1);
  /* 两行截断：中文一行只装十来个字，一行截会把标题截到看不出是哪条 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.digest-ref-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.digest-ref-board { color: var(--brand-600); }
.digest-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}
.digest-title-row .detail-title { flex: 1; margin-top: 0; }
