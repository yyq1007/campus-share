/* S3 发帖页 —— 只用 theme.wxss 令牌与 5.x 组件规范，禁止第二套视觉 */
.page {
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: var(--bg-gradient);
}

/* ---------- 渐变页头 ---------- */
.hero {
  position: relative;
  padding: 0 40rpx 28rpx;
  border-radius: 0 0 48rpx 48rpx;
}
.hero-nav {
  display: flex;
  align-items: center;
  /* 两个胶囊并排靠左：右侧留白避让微信原生胶囊，不得 space-between */
  justify-content: flex-start;
  gap: 20rpx;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}
.nav-back-icon { width: 32rpx; height: 32rpx; }
.nav-ph { width: 64rpx; }
.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-strong);
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}
.hero-deco {
  position: absolute;
  right: 48rpx;
  bottom: 12rpx;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.9;
}

/* ---------- 白卡 ---------- */
.card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: var(--bg-elevated);
  border-radius: 48rpx;
  box-shadow: var(--shadow-card);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 20rpx;
}
.card-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-soft);
  margin-left: 8rpx;
}

/* ---------- 板块胶囊 ---------- */
.board-row { display: flex; gap: 20rpx; }
.board-pill {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 36rpx;
  background: var(--fill-soft);
  color: var(--text-body);
  transition: all 0.2s;
}
.board-pill.is-on { color: var(--text-on-brand); font-weight: 600; }
.board-mint.is-on { background: var(--board-mint); }
.board-sky.is-on { background: var(--board-sky); }
.board-coral.is-on { background: var(--board-coral); }

/* ---------- 输入 ---------- */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.title-input { flex: 1; font-size: 34rpx; font-weight: 600; color: var(--text-strong); }
.count { font-size: 22rpx; color: var(--text-soft); }
.count-warn { color: var(--coral); }
.divider {
  height: 2rpx;
  margin: 24rpx 0;
  background: var(--fill-soft);
}
.content-input {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-body);
}
.content-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-soft);
}
.ph { color: var(--text-disabled); }
.reject-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--coral);
  background: var(--coral-a10);
  border-radius: 20rpx;
}

/* ---------- 动态字段 ---------- */
.field-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 20rpx;
}
.field-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--text-soft);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-body);
}

/* ---------- 媒体 ---------- */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.media-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.media-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}
.media-video { position: relative; width: 100%; height: 100%; }
.video-duration {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-on-brand);
  background: var(--scrim);
  border-radius: 12rpx;
}
.media-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand800-a85);
  border-radius: 22rpx;
}
.media-remove-icon { width: 22rpx; height: 22rpx; }
.media-uploaded {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mint);
  border-radius: 18rpx;
}
.media-ok-icon { width: 20rpx; height: 20rpx; }
.media-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-soft);
  background: var(--fill-soft);
  border-radius: 24rpx;
}
.media-add-icon { width: 44rpx; height: 44rpx; }

/* ---------- 链接 ---------- */
.link-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }

/* 发布入口在顶部导航胶囊（底部 fixed 栏已移除，无原生组件遮挡问题） */

/* ---- v4 设计稿对齐（追加覆盖） ---- */
.nav-pill {
  padding: 10rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-1);
  background: var(--bg-elevated);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}
.nav-pill-primary { color: var(--primary); font-weight: 600; }
.board-pick { padding: 0 40rpx 8rpx; }
.content-input { background: var(--bg-elevated); }
.field-label { display: none; }
.field-input { background: var(--brand-50); border-radius: 32rpx; padding: 0 24rpx; box-sizing: border-box; }
.media-add {
  width: 200rpx; height: 200rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--brand-200);
  background: var(--brand-50);
  color: var(--primary);
  flex-direction: column;
  gap: 0;
}
.media-add text { display: none; }
.footer-tip { line-height: 1.6; }
