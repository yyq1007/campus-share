<!--我的分享：状态 tabs + 帖子卡（可删/下线） -->
<view class="page">
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-inner" style="height:{{navH}}px">
      <view class="nav-btn" bind:tap="onBack">
        <image class="nav-btn-icon" src="/assets/icons/arrow-left.png" mode="aspectFit" />
      </view>
      <view class="nav-title">我的分享</view>
      <view class="nav-ph" />
    </view>
  </view>

  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view
        wx:for="{{tabs}}" wx:key="key"
        class="tab {{tab === item.key ? 'is-on' : ''}}"
        data-key="{{item.key}}" bind:tap="onTabTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <page-state wx:if="{{state === 'loading' || state === 'error' || state === 'empty'}}" state="{{state}}" bind:retry="onRetry" bind:action="onFab" actionText="去发一条" />

  <scroll-view wx:else scroll-y class="list" bindscrolltolower="onMore">
    <view class="feed">
      <post-card
        wx:for="{{list}}" wx:key="id" post="{{item}}"
        manageable="manage"
        bind:tap="onPostTap" bind:delete="onDelete"
      />
    </view>
    <view class="pad" />
  </scroll-view>

  <!-- FAB -->
  <view class="fab" bind:tap="onFab">
    <image class="fab-icon" src="/assets/icons/plus.png" mode="aspectFit" />
  </view>
</view>
