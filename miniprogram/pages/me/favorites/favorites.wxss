/* 我的收藏 —— v4 令牌 */
.page {
  min-height: 100vh;
  background: var(--bg-gradient);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}
.nav-btn-icon { width: 32rpx; height: 32rpx; }
.nav-title { font-size: 34rpx; font-weight: 600; color: var(--text-strong); }
.nav-ph { width: 64rpx; }

.list { height: calc(100vh - 200rpx); }
.feed { padding: 24rpx 32rpx 0; }
.pad { height: 160rpx; }
