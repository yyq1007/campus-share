<!--我的收藏：收藏流 -->
<view class="page">
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-inner" style="height:{{navH}}px">
      <view class="nav-btn" bind:tap="onBack">
        <image class="nav-btn-icon" src="/assets/icons/arrow-left.png" mode="aspectFit" />
      </view>
      <view class="nav-title">我的收藏</view>
      <view class="nav-ph" />
    </view>
  </view>

  <page-state wx:if="{{state === 'loading' || state === 'error' || state === 'empty'}}" state="{{state}}" bind:retry="onRetry" actionText="去逛逛" />

  <scroll-view wx:else scroll-y class="list" bindscrolltolower="onMore">
    <view class="feed">
      <post-card wx:for="{{list}}" wx:key="id" post="{{item}}" faved="{{true}}" bind:tap="onPostTap" bind:fav="onFav" />
    </view>
    <view class="pad" />
  </scroll-view>
</view>
