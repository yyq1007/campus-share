<!--协议页 -->
<view class="page">
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-inner" style="height:{{navH}}px">
      <view class="nav-btn" bind:tap="onBack">
        <image class="nav-btn-icon" src="/assets/icons/arrow-left.png" mode="aspectFit" />
      </view>
      <view class="nav-title">{{title}}</view>
      <view class="nav-ph" />
    </view>
  </view>

  <view class="doc-meta">更新于 {{updatedAt}}</view>

  <view class="card doc-card">
    <block wx:for="{{blocks}}" wx:key="index">
      <view wx:if="{{item.type === 'h'}}" class="doc-h">{{item.text}}</view>
      <view wx:else class="doc-p">{{item.text}}</view>
    </block>
  </view>

  <view class="doc-actions">
    <view class="btn-primary agree-btn" bind:tap="onAgree">同意并继续</view>
  </view>

  <view class="foot-note">点击左上方返回</view>
</view>
