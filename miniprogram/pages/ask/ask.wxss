/* S5 AI 问答 —— v4 软萌手账令牌 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-gradient);
}

/* ---------- 页头 ---------- */
.hero {
  padding: 0 32rpx 20rpx;
  border-radius: 0 0 48rpx 48rpx;
}
.hero-nav {
  display: flex;
  align-items: center;
}
.hero-title { font-size: 36rpx; font-weight: 600; color: var(--text-strong); }
.hero-sub { margin-top: 4rpx; font-size: 22rpx; color: var(--text-soft); }

/* ---------- 消息流 ---------- */
.chat {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}
.chat-pad { height: 32rpx; }
.msg {
  display: flex;
  margin-top: 28rpx;
  align-items: flex-start;
}
.msg.is-user { justify-content: flex-end; }

/* AI 气泡：白卡 */
/* 设计稿：AI 白卡气泡圆角 20px = 40rpx，左上小圆角 */
.bubble-ai {
  max-width: 78%;
  padding: 24rpx 28rpx;
  background: var(--bg-elevated);
  border-radius: 12rpx 40rpx 40rpx 40rpx;
  box-shadow: var(--shadow-soft);
}
.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-body);
  white-space: pre-wrap;
}

/* 用户气泡：主色实底 */
.bubble-user {
  max-width: 78%;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-on-brand);
  background: var(--primary);
  border-radius: 40rpx 12rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 20rpx var(--brand-a30);
  word-break: break-all;
}

/* 打字点 */
.dot-row { display: flex; gap: 10rpx; padding: 8rpx 0; }
.dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--primary);
  border-radius: 7rpx;
  opacity: 0.4;
  animation: blink 1.2s infinite;
}
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }
@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* ---------- 引用帖卡 ---------- */
.cite-wrap { margin-top: 20rpx; }
.cite-label {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}
.cite-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: var(--fill-soft);
  border-radius: 24rpx;
}
/* 设计稿：引用帖卡缩略图 56×56 */
.cite-cover {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
}
.cite-main { flex: 1; min-width: 0; }
.cite-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-strong);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cite-meta { margin-top: 6rpx; font-size: 22rpx; color: var(--primary); }
.cite-arrow { width: 26rpx; height: 26rpx; flex-shrink: 0; opacity: 0.4; }
.guide-btn {
  margin-top: 20rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-on-brand);
  background: var(--primary);
  border-radius: 34rpx;
}

/* ---------- 热门问题 ---------- */
.hot-wrap { margin-top: 32rpx; }
.hot-label {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--text-soft);
}
.hot-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.hot-chip {
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  color: var(--primary-deep);
  background: var(--bg-elevated);
  border-radius: 28rpx;
  box-shadow: var(--shadow-soft);
}

/* ---------- 输入区 ---------- */
.input-bar {
  position: relative; /* send-btn 的定位基准：缺失会相对页面定位、浮到内容区中部 */
  display: flex;
  align-items: center;
  padding: 16rpx 38rpx 8rpx;
  /* 不加 transition：键盘弹起时输入条先一步就位、键盘随后滑入，避免两个动画互相追赶显出不同步 */
}
/* 键盘弹起悬浮态：补白底让输入条盖在消息流上时仍有清晰边界 */
.input-bar.is-floating {
  background: var(--bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 24rpx var(--brand-a10, rgba(108, 92, 231, 0.06));
  padding-bottom: 20rpx;
}
/* 设计稿：底部胶囊输入框 338×50（=676×100rpx）；发送走键盘「发送」键，框内不放按钮 */.input-shell {
  position: relative;
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  background: var(--bg-elevated);
  border-radius: 50rpx;
  box-shadow: var(--shadow-soft);
  box-sizing: border-box;
}
.input-field { flex: 1; font-size: 28rpx; color: var(--text-body); }
.ph { color: var(--text-faint); }

/* ---------- AIGC 声明（设计 B5：输入框之下、11px 淡字；为自定义 TabBar 预留高度） ---------- */
.aigc-tip {
  padding: 8rpx 0 calc(112rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* ---- v4 设计稿对齐（追加覆盖） ---- */
.hero { text-align: center; }
.hero-nav { justify-content: center; }
.hero-title { font-size: 40rpx; }
.hero-sub {
  display: inline-block;
  margin: 10rpx auto 0;
  padding: 8rpx 28rpx;
  background: var(--brand-50);
  border: 2rpx solid var(--brand-100);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--primary-deep);
}
.bubble-user { background: var(--sky); box-shadow: 0 8rpx 20rpx var(--sky-a30); }
.hot-chip { background: var(--brand-50); color: var(--primary-deep); border: 2rpx solid var(--brand-100); }
.cite-card { background: var(--bg-elevated); border: 2rpx solid var(--brand-100); }
.cite-meta { color: var(--text-3); }
.input-shell {
  background: linear-gradient(100deg, var(--brand-50) 0%, var(--bg-elevated) 60%);
  border: 2rpx solid var(--brand-100);
}
